{
  "name": "@vornrun/connector-kusto",
  "version": "0.5.4",
  "description": "Trigger Vorn workflows from an Azure Data Explorer (Kusto) query",
  "type": "module",
  "license": "MIT",
  "author": "Javier Canizalez <javier-canizalez@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorn-run/vorn.git",
    "directory": "packages/connector-kusto"
  },
  "keywords": [
    "vorn",
    "connector",
    "kusto",
    "azure-data-explorer",
    "kql",
    "mcp"
  ],
  "bin": {
    "vorn-connector-kusto": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "yarn workspace @vornrun/connector-sdk build && tsup"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vornrun/connector-sdk": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
