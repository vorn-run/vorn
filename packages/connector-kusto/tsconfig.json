{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@vornrun/connector-sdk": ["../connector-sdk/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
