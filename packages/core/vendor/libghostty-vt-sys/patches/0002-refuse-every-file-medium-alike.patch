+    /// Opens `path` for reading without waiting on a FIFO or device.
+    fn openNonBlocking(io: std.Io, path: []const u8) !std.Io.File {
+        const os = builtin.os.tag;
+        if (comptime !(os.isDarwin() or os.isBSD() or os == .linux)) {
+            return std.Io.Dir.cwd().openFile(io, path, .{});
