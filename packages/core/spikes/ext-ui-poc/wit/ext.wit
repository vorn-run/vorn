package vorn:ext-ui-poc@0.1.0;

/// The extension's backend: the part that runs beside vornd in both models.
world backend {
  /// Model A only: the view template, as JSON.
  export view: func() -> string;
  /// Keyed rows from vornd's `worktree:inventory` answer.
  export rows: func(inventory: string) -> string;
  /// The `worktree:removeMany` items for the chosen row ids, or an error.
  export remove-plan: func(ids: list<string>) -> result<string, string>;
}

interface surface {
  /// One input, in logical pixels (cells on the Cells surface).
  variant input {
    pointer-move(tuple<f32, f32>),
    pointer-down,
    pointer-up,
    wheel(f32),
    key(key-press),
  }
  record key-press {
    code: string,
    text: option<string>,
    mods: u16,
  }
  record cell {
    sym: string,
    fg: u32,
    bg: u32,
    attr: u8,
  }
  /// What one frame drew: RGBA pixels, or a grid of cells.
  variant frame {
    pixels(list<u8>),
    cells(list<cell>),
  }
}

/// Model B: the extension's own UI, run by each client on its own surface.
world ui {
  use surface.{input, frame};
  /// Calls the extension's backend (through the client and vornd).
  import call: func(method: string, args: string) -> result<string, string>;
  export init: func(cells: bool, scale: f32);
  export data: func(rows: string);
  export frame: func(w: u32, h: u32, inputs: list<input>) -> frame;
}

/// Model C: an element tree the client lays out and draws with its own vornui.
interface tree {
  /// A theme colour by meaning; the client resolves it on every surface.
  enum token { base, overlay, ink, ink-secondary, ink-faint, muted, accent, good, warn, bad, info, neutral, white }
  variant paint {
    token(token),
    /// A token at an alpha.
    tint(tuple<token, f32>),
    clear,
  }
  enum text-size { xs, sm, base, lg }
  enum radius { sm, md, lg, full }
  enum tone { neutral, good, warn, bad, info }
  /// What a box is to assistive technology, beyond what its kind says.
  enum role { group, image, status }
  record confirm {
    message: string,
    ok: string,
    danger: bool,
  }
  variant prop {
    row,
    col,
    gap(f32),
    pad(f32),
    pad-x(f32),
    pad-y(f32),
    w(f32),
    h(f32),
    w-full,
    h-full,
    grow,
    min-h(f32),
    items-center,
    justify-between,
    bg(paint),
    /// The background while hovered, blended by the client.
    hover-bg(paint),
    border(tuple<f32, paint>),
    rounded(radius),
    opacity(f32),
    weight(u16),
    mono,
    truncate,
    /// Reports `click` events.
    click,
    /// A press that travels reports `drag-over` with the id under the pointer.
    drag,
    disabled,
    /// What the box shows on a cells surface instead of its content.
    glyph(string),
    /// Its role and accessible name.
    access(tuple<role, string>),
    /// A button's confirm popover: `<id>.ok` and `<id>.cancel` report clicks.
    confirm(confirm),
  }
  variant kind {
    %box,
    text(tuple<string, text-size, paint>),
    /// An SVG over the whole box in one paint.
    shape(tuple<string, paint>),
    button(string),
    /// A one-line text field: name and placeholder; its text reaches the extension by `change`.
    field(tuple<string, string>),
    badge(tuple<string, tone>),
    /// A scrolling listbox, named.
    %list(string),
  }
  /// One box, depth first: its `children` boxes follow it.
  record node {
    kind: kind,
    id: option<string>,
    children: u32,
    props: list<prop>,
  }
  record surface {
    cells: bool,
    width: f32,
    height: f32,
  }
  enum event-kind { click, change, drag-over, submit }
}

/// Model C: the extension's UI as code that returns a tree; the client draws it.
world ui-c {
  use tree.{node, surface, event-kind};
  import call: func(method: string, args: string) -> result<string, string>;
  /// All rows, replacing the ones it had.
  export data: func(rows: string);
  /// One row op, as model A's client applies it.
  export patch: func(op: string);
  export render: func(surface: surface) -> list<node>;
  /// Something happened to box `id`; true when the tree should be rendered again.
  export event: func(id: string, kind: event-kind, data: string) -> bool;
}

/// The tree's types alone, for the guest SDK.
world sdk {
  import tree;
}
