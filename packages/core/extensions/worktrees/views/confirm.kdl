// Asked before a worktree with sessions or changes is removed.
schema "vorn:view@1"

rows "asked" {
    name string
    branch string
    project_path string
    sessions number
    dirty bool
}

column {
    text "Remove {asked.name}?" role=title
    text "Branch {asked.branch}" role=secondary
    text "Its {asked.sessions} running sessions are closed first." when="{asked.sessions}"
    text "It has uncommitted changes, which are lost." when="{asked.dirty}"
    row {
        text "" grow=#true
        button Cancel call="cancel" close=#true
        button Remove call="confirm" close=#true style=danger
    }
}
