// Every agent's status, and the tools they wait to use.
schema "vorn:view@1"

rows "agents" {
    name string
    agent string
    status enum running waiting idle error
}

rows "permissions" {
    tool string
    agent string
    description string
    question bool
    ready bool
}

// The rules an agent offers to keep along with an Allow.
rows "suggestions" {
    request string
    label string
}

// The options of a question an agent asks; `ask` heads the first of each question.
rows "options" {
    request string
    ask string
    label string
    picked bool
}

column {
    row {
        text "{agents.status.running}/{agents.count} running" role=secondary grow=#true
        button Collapse window="compact"
        button Vorn show=#true
    }
    list "permissions" {
        column {
            row {
                badge "{row.tool}"
                text "{row.agent}" role=secondary grow=#true
            }
            text "{row.description}" role=mono when="!{row.question}"
            row when="!{row.question}" {
                button Allow call="allow" style=primary
                button Deny call="deny"
            }
            list "suggestions" where="request" is="{row.id}" {
                button "{row.label}" call="suggest"
            }
            list "options" where="request" is="{row.id}" {
                column {
                    text "{row.ask}" role=secondary when="{row.ask}"
                    button "{row.label}" call="pick" style=primary when="{row.picked}"
                    button "{row.label}" call="pick" when="!{row.picked}"
                }
            }
            row when="{row.question}" {
                button Submit call="submit" style=primary when="{row.ready}"
                button Skip call="deny"
            }
        }
    }
    divider when="{permissions.count}"
    list "agents" empty="No active agents" {
        row {
            status "{row.status}" running=good waiting=warn idle=muted error=bad
            text "{row.name}" grow=#true
            button Show focus="{row.id}" show=#true
        }
    }
}
