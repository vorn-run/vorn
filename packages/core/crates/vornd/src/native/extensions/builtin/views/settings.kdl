// Every worktree of every project, grouped by project: what each costs on
// disk, why, and what can safely go.
schema "vorn:view@1"

rows "worktrees" {
    name string
    project string
    project_path string
    project_size string
    branch string
    size string
    detail string
    verdict enum keep orphan review reclaim remove
    reasons string
    dirty bool
    orphan bool
    reclaimable bool
    remove_dirty bool
    remove_clean bool
}

rows "scan" {
    busy bool
    error string
}

column {
    toolbar {
        button Refresh call="refresh" icon="refresh-cw"
    }
    notice "{scan.error}" tone=bad when="{scan.error}"
    list "worktrees" by="project_path" heading="{row.project}" aside="{row.project_size}" busy="{scan.busy}" loading="Measuring worktrees…" empty="No worktrees yet. Each one shows here once you create it." {
        entry "{row.name}" detail="{row.detail}" {
            icon "folder-git-2"
            text "{row.size}" role=number
            button "Free space" call="reclaim" when="{row.reclaimable}"
            more {
                button "Free space" call="reclaim" icon="hard-drive" when="{row.reclaimable}"
                button "Delete folder" call="prune" icon="trash-2" style=danger confirm="Delete the folder {row.name}?" when="{row.orphan}"
                button Remove call="remove" icon="trash-2" style=danger confirm="Remove {row.name}? Its uncommitted changes are lost." when="{row.remove_dirty}"
                button Remove call="remove" icon="trash-2" style=danger confirm="Remove {row.name}?" when="{row.remove_clean}"
            }
        }
    }
}
