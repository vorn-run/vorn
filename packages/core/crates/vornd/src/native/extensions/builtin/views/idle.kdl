// Worktrees whose last session ended: keep them or remove them.
schema "vorn:view@1"

rows "idle" {
    name string
    project string
    project_path string
    dirty bool
}

column when="{idle.count}" {
    list "idle" {
        row {
            icon git-branch
            text "{row.name}" grow=#true
            badge "changes" when="{row.dirty}" changes=warn
            button Keep call="keep"
            button Remove call="remove" style=danger confirm="Remove {row.name}? Its uncommitted changes are lost." when="{row.dirty}"
            button Remove call="remove" style=danger when="!{row.dirty}"
        }
    }
}
