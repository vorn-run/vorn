// Every install starts with this once, switched off: the dev server comes back with its session.
workflow "Bring the dev server back" {
    id "system:dev-server-on-restore"
    icon "RotateCcw"
    iconColor "#c9972a"
    enabled #false
    workspaceId "personal"
    trigger "sessionRestored" id="trigger-1" label="When a session is restored" x=0 y=0
    step "script" id="script-1" label="Start the dev server" x=0 y=120 needs="trigger-1#e1" {
        scriptType "bash"
        scriptContent "yarn dev"
        cwd "{{context.projectPath}}"
    }
}
