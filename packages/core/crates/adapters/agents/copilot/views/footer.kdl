// What Copilot is doing on this card, as its hooks report it: the model it
// was started with, its tool calls and the last tool it ran.
schema "vorn:view@1"

rows "sessions" {
    model string
    tool string
    tools number
}

row when="{row.tools}" {
    icon wrench
    text "{row.tools} tool calls · last {row.tool}" role=secondary grow=#true
    text "{row.model}" role=secondary
}
