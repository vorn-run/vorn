[
  {
    "name": "list_tasks",
    "description": "List tasks, optionally filtered by project, status, assigned agent, or workspace. Archived tasks are excluded by default; pass include_archived=true to include them.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "project_name": {
          "description": "Filter by project name",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "description": "Filter by status",
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "in_review",
            "done",
            "cancelled"
          ]
        },
        "assigned_agent": {
          "description": "Filter by assigned agent type",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "workspace_id": {
          "description": "Filter by workspace ID (returns tasks from all projects in that workspace)",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "include_archived": {
          "description": "Include archived tasks in the result (default: false)",
          "type": "boolean"
        }
      }
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "create_task",
    "description": "Create a new task in a project",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Project name (must match existing project)"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Task title"
        },
        "description": {
          "description": "Task description (markdown)",
          "type": "string",
          "maxLength": 5000
        },
        "status": {
          "description": "Task status (default: todo)",
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "in_review",
            "done",
            "cancelled"
          ]
        },
        "branch": {
          "description": "Git branch for this task",
          "type": "string",
          "maxLength": 200
        },
        "use_worktree": {
          "description": "Create a git worktree for this task",
          "type": "boolean"
        },
        "assigned_agent": {
          "description": "Assign to an agent type",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        }
      },
      "required": [
        "project_name",
        "title"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "get_task",
    "description": "Get a task by ID",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Task ID"
        }
      },
      "required": [
        "id"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
