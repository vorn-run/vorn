  {
    "name": "launch_session",
    "description": "Launch an AI agent session (interactive terminal or headless). Requires the Vorn app to be running.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "agent_type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$",
          "description": "Agent type to launch"
        },
        "project_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Project name"
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "description": "Absolute path to project directory"
        },
        "prompt": {
          "description": "Initial prompt to send to the agent",
          "type": "string",
          "maxLength": 10000
        },
        "branch": {
          "description": "Git branch to checkout",
          "type": "string",
          "maxLength": 200
        },
        "use_worktree": {
          "description": "Create a git worktree",
          "type": "boolean"
        },
        "display_name": {
          "description": "Display name for the session",
          "type": "string",
          "maxLength": 200
        },
        "headless": {
          "description": "Launch as headless (no UI) session",
          "type": "boolean"
        }
      },
      "required": [
        "agent_type",
        "project_name",
        "project_path"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
