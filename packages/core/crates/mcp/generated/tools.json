  {
    "name": "publish_artifact",
    "description": "Publish a page, doc or design for the person to review. It opens in your session browser pane, where they can comment on the exact words and send their notes back to you as one message. Pass artifactId to publish the next version of an artifact after addressing comments. A page or design is self-contained HTML (no network: inline styles, scripts and images as data: URIs); a doc is Markdown.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "page",
            "doc",
            "design"
          ],
          "description": "page: any HTML; doc: Markdown; design: HTML with a design manifest"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "What the artifact is called in the pane"
        },
        "file": {
          "description": "A .html or .md file inside your project or worktree; give this or content",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content": {
          "description": "The HTML or Markdown itself",
          "type": "string",
          "maxLength": 5242880
        },
        "artifactId": {
          "description": "Publish the next version of this artifact",
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "open": {
          "description": "Open it in the browser pane (default true)",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "title"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
