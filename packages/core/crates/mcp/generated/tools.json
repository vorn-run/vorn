  {
    "name": "list_sessions",
    "description": "List terminal sessions. Filter by status: \"active\" (running terminals) or \"recent\" (past sessions).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "filter": {
          "description": "Session filter (default: active)",
          "type": "string",
          "enum": [
            "active",
            "recent"
          ]
        },
        "project_name": {
          "description": "Filter by project name",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "project_path": {
          "description": "Filter by project path (for recent sessions)",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "execution": {
      "taskSupport": "forbidden"
    }
