          "description": "Session ID to kill"
        },
        "headless": {
          "description": "Kill a headless session instead of a terminal",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ]
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
