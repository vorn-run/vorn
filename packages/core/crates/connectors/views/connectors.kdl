// Connections: every connection with what it triggers and when it last
// synced, and adding one from an installed connector.
schema "vorn:view@1"

rows "connections" {
    name string
    icon string
    line string
    state enum ok failing idle signin
    needs_signin bool
    can_roll_back bool
    previous string
}

rows "form" {
    picked bool
    can_save bool
    none_installed bool
    error string
}

rows "connectors" {
    name string
    selected bool
}

rows "triggers" {
    name string
    selected bool
}

rows "projects" {
    name string
    selected bool
}

rows "settings" {
    label string
    hint string
    secret bool
    value string
    kept bool
}

column {
    toolbar when="!{form.count}" {
        button "Add connection" call="add" style=primary icon="plus"
    }
    section "New connection" when="{form.count}" {
        notice "No connector is installed yet. Connectors for other services are in Extensions › Browse." when="{form.none_installed}"
        column when="!{form.none_installed}" {
            text "Service" role=secondary
            choice "connectors" label="{row.name}" selected="{row.selected}" call="pick"
        }
        column when="{form.picked}" {
            text "Trigger" role=secondary
            choice "triggers" label="{row.name}" selected="{row.selected}" call="trigger"
        }
        list "settings" when="{form.picked}" {
            column {
                row {
                    text "{row.label}" role=secondary grow=#true
                    text "Saved" role=secondary when="{row.kept}"
                }
                field value="{row.value}" placeholder="{row.hint}" call="set" when="!{row.secret}"
                field placeholder="{row.hint}" call="set" secret=#true when="{row.secret}"
            }
        }
        column when="{form.picked}" {
            text "Tasks go to" role=secondary
            choice "projects" label="{row.name}" selected="{row.selected}" call="project"
        }
        notice "{form.error}" tone=bad when="{form.error}"
        row {
            button Save call="save" style=primary when="{form.can_save}"
            button Cancel call="cancel"
        }
    }
    list "connections" empty="No connections yet. Add one to have a workflow watch a service." {
        entry "{row.name}" detail="{row.line}" {
            status "{row.state}" ok=good failing=bad idle=muted signin=warn
            icon "{row.icon}"
            button "Sign in" signin="{row.id}" style=primary when="{row.needs_signin}"
            button Test call="test"
            button "Import now" call="backfill"
            more {
                button Test call="test" icon="zap"
                button "Import now" call="backfill" icon="import"
                button "Roll back to v{row.previous}" call="rollback" icon="rotate-ccw" when="{row.can_roll_back}"
                button Remove call="remove" style=danger icon="trash-2" confirm="Remove {row.name}? Its tasks stay on the board."
            }
        }
    }
    text "Connectors for other services are in Extensions › Browse." role=secondary when="!{form.count}"
}
