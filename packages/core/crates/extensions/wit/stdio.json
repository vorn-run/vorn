{
  "package": "vorn:extension@1.0.0",
  "api": "vorn:extension@1.0",
  "types": {
    "json": { "inline": "any JSON value" },
    "ext-error": { "record": [["code", "string"], ["message", "string"]] },
    "header": { "record": [["name", "string"], ["value", "string"]] },
    "request": { "record": [["method", "string"], ["url", "string"], ["headers", "list<header>"], ["body", "option<string>"]] },
    "response": { "record": [["status", "u16"], ["headers", "list<header>"], ["body", "string"]] },
    "call-ctx": { "record": [["caller", "string"], ["project", "option<string>"]] },
    "init-ctx": { "record": [["id", "string"], ["version", "string"], ["vorn", "string"], ["api", "string"]] },
    "row-op": { "variant": [["upsert", "json"], ["delete", "string"], ["clear", null]] },
    "event": { "record": [["name", "string"], ["data", "json"]] },
    "level": { "enum": ["debug", "info", "warn", "error"] },
    "bytes": { "inline": "a base64 string" },
    "statement": { "record": [["sql", "string"], ["params", "list<json>"]] },
    "blob": { "record": [["name", "string"], ["size", "u64"], ["modified", "u64"]] },
    "session-start": { "record": [["project", "string"], ["agent", "option<string>"], ["prompt", "option<string>"], ["worktree", "bool"], ["branch", "option<string>"], ["name", "option<string>"], ["headless", "bool"]] }
  },
  "methods": [
    { "method": "host.call", "answers": "host", "params": [["method", "string"], ["args", "json"]], "result": "json", "error": "ext-error" },
    { "method": "host.publish", "answers": "host", "params": [["collection", "string"], ["ops", "list<row-op>"]], "result": null, "error": null },
    { "method": "host.log", "answers": "host", "params": [["level", "level"], ["message", "string"]], "result": null, "error": null },
    { "method": "host.rows", "answers": "host", "params": [["collection", "string"]], "result": "list<json>", "error": "ext-error" },
    { "method": "host.start-session", "answers": "host", "params": [["req", "session-start"]], "result": "string", "error": "ext-error" },
    { "method": "net.fetch", "answers": "host", "params": [["req", "request"], ["connection", "option<string>"]], "result": "response", "error": "ext-error" },
    { "method": "storage.prefix", "answers": "host", "params": [], "result": "string", "error": "ext-error" },
    { "method": "storage.query", "answers": "host", "params": [["sql", "string"], ["params", "list<json>"]], "result": "list<json>", "error": "ext-error" },
    { "method": "storage.exec", "answers": "host", "params": [["sql", "string"], ["params", "list<json>"]], "result": "u64", "error": "ext-error" },
    { "method": "storage.get", "answers": "host", "params": [["key", "string"]], "result": "option<json>", "error": "ext-error" },
    { "method": "storage.set", "answers": "host", "params": [["key", "string"], ["value", "json"]], "result": "_", "error": "ext-error" },
    { "method": "storage.transaction", "answers": "host", "params": [["statements", "list<statement>"]], "result": "list<json>", "error": "ext-error" },
    { "method": "blobs.put", "answers": "host", "params": [["name", "string"], ["data", "bytes"]], "result": "_", "error": "ext-error" },
    { "method": "blobs.get", "answers": "host", "params": [["name", "string"]], "result": "option<bytes>", "error": "ext-error" },
    { "method": "blobs.list", "answers": "host", "params": [["prefix", "string"]], "result": "list<blob>", "error": "ext-error" },
    { "method": "blobs.delete", "answers": "host", "params": [["name", "string"]], "result": "bool", "error": "ext-error" },
    { "method": "guest.init", "answers": "guest", "params": [["ctx", "init-ctx"]], "result": "_", "error": "ext-error" },
    { "method": "guest.handle", "answers": "guest", "params": [["method", "string"], ["args", "json"], ["ctx", "call-ctx"]], "result": "json", "error": "ext-error" },
    { "method": "guest.on-event", "answers": "guest", "params": [["batch", "list<event>"]], "result": null, "error": null }
  ]
}
