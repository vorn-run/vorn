// The extension API: what vornd offers an extension and what an extension
// answers. This file is the only definition. vorn-extensions generates its
// method names, parameters, errors and types from it at build time, and
// `stdio.json` beside it is the same mapping for authors in other languages.
//
// Over stdio each function `f` of interface `i` is the JSON-RPC 2.0 method
// `i.f`, one message per line. Its params are an object keyed by the
// parameter names. A function with a result is a request and is answered:
// `result<T, ext-error>` answers with T as the result, or with the error as
// `{"code": -32000, "message": .., "data": {"code": ..}}`. A function with no
// result is a notification and is not answered. `json` travels inline as a
// JSON value; a record is an object keyed by its field names; an option is
// the value or null; a variant is `{"case": payload}`, or `"case"` when the
// case carries nothing; an enum is its case's name.
//
// A one-shot program gets one `guest.handle` request, always with id 1, and
// exits after answering. A service is sent `guest.init` first, then calls and
// events until its stdin closes.
//
// Every package names this one API, `api = "vorn:extension@1.0"`; what kind
// of package it is beyond an extension is a section of its manifest, not
// another api id. A `[connector]` section (auth, triggers, actions) means its
// service speaks the connector protocol instead of these interfaces: the
// JSON-RPC child protocol 1 (`vorn/hello`, `poll`, `action`, ...) that this
// API version includes and versions with it. A package may add the places
// it draws, MCP tools or events beside its kind section; its service then also
// runs as an extension, and the first message it is sent, `guest.init` or
// `vorn/hello`, says which role a process plays. What it draws is an element
// tree it answers `ui.render` with (`vorn-tree`).
//
// A service is a program (`[service] command`) or a Wasm component
// (`[service] component = "x.wasm"`) built for this world on
// `wasm32-wasip2`. A component imports these interfaces instead of speaking
// JSON-RPC, and vornd answers each import exactly as it answers the method of
// the same name over stdio. It is given WASI preview 2 with nothing granted:
// no files, network or environment beyond what it asks through these imports.
//
// UI is an element tree (`vorn-tree`): a `tree = true` contribution is drawn
// from what `guest.handle` answers `ui.render` with, `{point, surface}` in
// and `{tokens, tree}` out, and `ui.event` with `{point, event}` tells the
// extension what was clicked, typed or chosen there.
//
// A `[[contributes.toolbar]]` item sits in the window's toolbar beside the
// app's own (View, New, Split), where a person can reorder or hide it. It has
// an id, `icon`, `title` and `description` (its tooltip), and does one thing:
// `call` a method, open a `window`, or, with `tree = true`, show its tree in a
// popover under the icon, rendered with `{point, surface}` as any tree is. A
// `[[contributes.groupings]]` entry is a way to group the sidebar's sessions:
// each row of its `rows` collection is `{id: <session id>, group: <heading>}`,
// headings in the order the rows first name them, unnamed sessions last.
// `sessions.recent` lists the agent conversations this machine ran (in
// `project`, else everywhere), and `sessions.launch` with `resume` set to
// one's `sessionId` (and its `agent`) starts that conversation again.
//
// An `[agent]` section makes the package an agent adapter: everything Vorn
// needs to run one agent CLI, as data, with no program. Its fields (checked
// against `vorn_agents::AgentSpec`; docs/adding-an-agent.md walks through
// them):
//
//   id, name, label, short_name   the agent type sessions carry, and its names
//   description, url, install     what Settings shows
//   icon, mark, color, tint       its SVG mark in the package, one character
//                                 for text surfaces, its accent and tint
//   [agent.launch]                command, args, headless_args, and how a first
//                                 prompt rides the line: prompt = ["{prompt}"]
//   [agent.resume]                args that resume conversation {id}, `at` the
//                                 end or the start (a subcommand), `pin` to
//                                 start one under an id chosen beforehand,
//                                 the `selectors` a configured line may carry,
//                                 and `capture`: a query that reads the
//                                 conversation from the agent's own database
//   [agent.headless]              the arguments that end a headless run with
//                                 and without a prompt (which goes to stdin),
//                                 `resume` or `resume_tail` for a resumed run,
//                                 and `stream`: the package's service reads
//                                 what the run prints (see `guest.handle`)
//   [agent.models]                the model `flag`, the `selectors` and
//                                 `config` overrides it replaces, `group` by
//                                 provider, and `list`: a JSON-lines exchange
//                                 (`steps` of send, reply, fail, require,
//                                 models, next and cursor) or `lines` printed
//                                 by one run, read through `choice`
//   [agent.history]               where past conversations are: `jsonl`,
//                                 `sqlite` or `json_files`, with `activity`,
//                                 `title_limit`, and `rank` for sessions of
//                                 different agents at the same moment
//   [[agent.status]]              screen rules, first match wins: status,
//                                 rows or cursor_rows, any, all, none,
//                                 cursor, title
//   [agent.hooks]                 `settings`: HTTP hooks merged into the
//                                 agent's JSON settings, `own_status` from
//                                 the version that reports OSC 7501; or
//                                 `file`: a hooks file of Vorn's own
//   [agent.env]                   variables the agent sets in its sessions,
//                                 stripped from every process Vorn starts
//   [agent.usage], [agent.mcp]    where context use is recorded, and how the
//                                 agent connects to Vorn's tools
//
// Paths start with `~`, `{data}`, `{env:NAME|fallback}` or `/`, and never
// hold `..`; the hook files Vorn writes are `.json`. A session's status is
// read in this order: what the agent reports itself (OSC 7501), then its
// hooks, then its screen rules. An adapter may draw trees beside the section
// as any extension does (examples/extensions/agent-footer).
//
// Versioning: the package version is MAJOR.MINOR.PATCH, and a manifest's
// `api` names MAJOR.MINOR. A minor release only adds (a function, a bridge
// method, an event), so a package built for 1.0 runs on every 1.x Vorn; a
// package built for a newer minor or another major is refused, at install
// and when it starts, with a message naming both versions. A component's
// imports carry the version it was built against, read before it is linked;
// a program learns the version Vorn speaks from `init-ctx.api`.

package vorn:extension@1.0.0;

interface types {
  /// Any JSON value.
  type json = string;

  /// A failed call: a stable code a caller can match, and words a person reads.
  record ext-error {
    code: string,
    message: string,
  }

  record header {
    name: string,
    value: string,
  }

  record request {
    method: string,
    url: string,
    headers: list<header>,
    body: option<string>,
  }

  record response {
    status: u16,
    headers: list<header>,
    body: string,
  }

  /// Who is calling, and about which project.
  record call-ctx {
    caller: string,
    project: option<string>,
  }

  /// What a service is started with: its own id and version, the Vorn
  /// release, and the API that Vorn speaks (`vorn:extension@1.0`), which a
  /// program built for a newer one refuses to start on.
  record init-ctx {
    id: string,
    version: string,
    vorn: string,
    api: string,
  }

  /// One change to a collection of keyed rows; a row's key is its `id`.
  variant row-op {
    upsert(json),
    delete(string),
    clear,
  }

  record event {
    name: string,
    data: json,
  }

  enum level {
    debug,
    info,
    warn,
    error,
  }

  /// Bytes; over stdio a base64 string (standard alphabet, padded).
  type bytes = list<u8>;

  /// One statement of a transaction, with its `?` params.
  record statement {
    sql: string,
    params: list<json>,
  }

  /// A file in the extension's own file store.
  record blob {
    /// Its name: segments of letters, digits, `.`, `_` and `-`, joined by `/`.
    name: string,
    size: u64,
    /// When it was last written, in milliseconds since the Unix epoch.
    modified: u64,
  }

  /// A session to start, as the app and the MCP tools start one.
  record session-start {
    /// The folder of the project it runs in.
    project: string,
    /// An agent type as `agents.list` names it; none starts a shell.
    agent: option<string>,
    /// What an agent is asked first.
    prompt: option<string>,
    /// Starts it in a new worktree of the project.
    worktree: bool,
    /// The new worktree's branch.
    branch: option<string>,
    /// The card's name.
    name: option<string>,
    /// An agent run with no terminal; what it prints is read by Vorn.
    headless: bool,
  }
}

/// What vornd answers, checked against the manifest's declared uses.
interface host {
  use types.{json, ext-error, level, row-op, session-start};

  /// A core method, such as `sessions.list`, if the manifest declares the permission it needs.
  call: func(method: string, args: json) -> result<json, ext-error>;
  /// Changes the rows of a collection; a change asks for its trees again.
  publish: func(collection: string, ops: list<row-op>);
  log: func(level: level, message: string);
  /// The rows it published to `collection`, in the order they came; they
  /// outlive a restart of its service, so state a tree draws lives there.
  rows: func(collection: string) -> result<list<json>, ext-error>;
  /// Starts a session the way the app and the MCP tools do, under the
  /// `sessions.launch` permission; answers the new session's id.
  start-session: func(req: session-start) -> result<string, ext-error>;
}

/// HTTP made by vornd: only to the manifest's declared hosts, with the
/// connection's credential added there and never shown to the extension.
interface net {
  use types.{request, response, ext-error};

  fetch: func(req: request, connection: option<string>) -> result<response, ext-error>;
}

/// The extension's own tables in Vorn's database, under the `storage`
/// permission. A table it makes is named with its prefix, `x_<id>_`, which
/// `init-ctx` does not carry: `storage.prefix` answers it. A statement on any
/// other table fails, naming it.
interface storage {
  use types.{json, ext-error, statement};

  /// The prefix its tables are named with.
  prefix: func() -> result<string, ext-error>;
  /// The rows a query answers, each an object keyed by column.
  query: func(sql: string, params: list<json>) -> result<list<json>, ext-error>;
  /// Runs one statement; answers how many rows it changed.
  exec: func(sql: string, params: list<json>) -> result<u64, ext-error>;
  /// The value kept under a key, or null.
  get: func(key: string) -> result<option<json>, ext-error>;
  /// Keeps a value under a key; null removes it.
  set: func(key: string, value: json) -> result<_, ext-error>;
  /// Runs `statements` in order as one transaction: all of them, or none
  /// when one fails. Answers each one's rows when it reads any, else how
  /// many rows it changed.
  transaction: func(statements: list<statement>) -> result<list<json>, ext-error>;
}

/// The extension's own files, kept by Vorn under the `storage` permission:
/// up to 10 MiB a file and 256 MiB in all. They go when the extension is removed.
interface blobs {
  use types.{bytes, blob, ext-error};

  /// Writes `data` as `name`, whole or not at all.
  put: func(name: string, data: bytes) -> result<_, ext-error>;
  /// The file `name`, or none.
  get: func(name: string) -> result<option<bytes>, ext-error>;
  /// The files whose names start with `prefix`, by name.
  %list: func(prefix: string) -> result<list<blob>, ext-error>;
  /// Removes `name`; answers whether there was one.
  delete: func(name: string) -> result<bool, ext-error>;
}

/// What the extension answers.
interface guest {
  use types.{json, ext-error, call-ctx, init-ctx, event};

  init: func(ctx: init-ctx) -> result<_, ext-error>;
  /// `ui.render` with `{point, surface}` answers the tree a `tree = true`
  /// contribution draws, `{tokens, tree}`; `ui.event` with `{point, event}`
  /// answers what follows a click, a toggle, a choice or a field's Return:
  /// `{toast?, error?, patch?, open?, window?, close?, focus?, show?, url?, signin?}`,
  /// `signin` being the window's target, `{id, name, browser: {signInUrl, origins, check}}`.
  /// An agent adapter whose `[agent.headless]` says `stream = true` is called
  /// `agent.stream` with `{session, lines}`, what a headless run printed, and
  /// answers `{conversation?, events?: [{event, tool?}]}`: the conversation
  /// the run took, and hook events by Vorn's names (`PreToolUse`, `Stop`, ...).
  handle: func(method: string, args: json, ctx: call-ctx) -> result<json, ext-error>;
  on-event: func(batch: list<event>);
}

world extension {
  import host;
  import net;
  import storage;
  import blobs;
  export guest;
}
