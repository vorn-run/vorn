{
  "id": "review",
  "name": "Review",
  "version": "0.1.0",
  "kind": "extension",
  "protocol": 1,
  "description": "Reads the session",
  "permissions": ["terminal.read"],
  "activates": { "workspaceContains": ["package.json"] },
  "contributes": {
    "footers": [{ "id": "checks", "title": "Checks", "every": 30 }],
    "panes": [{ "id": "report", "title": "Report", "web": "web/report/index.html" }]
  }
}
