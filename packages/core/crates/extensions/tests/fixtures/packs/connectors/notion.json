{
  "protocol": 1,
  "id": "notion",
  "name": "Notion",
  "version": "0.1.3",
  "kind": "connector",
  "description": "Trigger workflows from Notion database pages, and create or update them.",
  "icon": {
    "viewBox": "0 0 24 24",
    "paths": [
      "M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.98-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466z",
      "M5.25 8.058v13.904c0 .747.373 1.027 1.214.98L20.99 22.1c.841-.046.935-.56.935-1.167V7.122c0-.606-.233-.933-.748-.887l-14.7.855c-.56.047-.746.327-.746.933zm14.28.7c.093.42 0 .84-.42.888l-.68.135v9.966c-.59.317-1.132.498-1.588.498-.727 0-.909-.227-1.453-.907l-4.451-6.992v6.765l1.408.317s0 .816-1.136.816l-3.132.181c-.09-.181 0-.635.317-.726l.818-.226V9.801L8.06 9.71c-.09-.42.137-1.021.784-1.067l3.359-.227 4.678 7.148V9.393l-1.181-.136c-.091-.5.273-.863.727-.908z"
    ]
  },
  "auth": {
    "rung": "key",
    "keys": ["token"]
  },
  "triggers": [
    {
      "type": "pageChanged",
      "label": "A page is created or changed",
      "description": "Fires once per page in the database that Vorn has not seen at this time. Deleted and moved pages produce no event — polling only sees what still matches.",
      "statusMapping": [
        {
          "upstream": "Not started",
          "suggestedLocal": "todo"
        },
        {
          "upstream": "To-do",
          "suggestedLocal": "todo"
        },
        {
          "upstream": "Backlog",
          "suggestedLocal": "todo"
        },
        {
          "upstream": "In progress",
          "suggestedLocal": "in_progress"
        },
        {
          "upstream": "In review",
          "suggestedLocal": "in_review"
        },
        {
          "upstream": "Doing",
          "suggestedLocal": "in_progress"
        },
        {
          "upstream": "Done",
          "suggestedLocal": "done"
        },
        {
          "upstream": "Complete",
          "suggestedLocal": "done"
        },
        {
          "upstream": "Shipped",
          "suggestedLocal": "done"
        },
        {
          "upstream": "Cancelled",
          "suggestedLocal": "cancelled"
        },
        {
          "upstream": "Archived",
          "suggestedLocal": "cancelled"
        }
      ],
      "defaultWorkflow": {
        "name": "Notion: database pages",
        "defaultCronFromMinutes": 5
      },
      "setup": {
        "connectorId": "notion",
        "triggerType": "pageChanged",
        "env": [
          {
            "name": "NOTION_TOKEN",
            "required": true,
            "secret": true,
            "description": "An internal integration token or personal API key from notion.so/profile/integrations. There is no Notion CLI to sign in with."
          },
          {
            "name": "NOTION_DATABASE_ID",
            "required": true,
            "secret": false,
            "description": "Paste the database URL, or the 32-character id from it."
          },
          {
            "name": "NOTION_DATA_SOURCE_ID",
            "required": false,
            "secret": false,
            "description": "Only needed when the database has more than one data source. Blank resolves it."
          },
          {
            "name": "NOTION_FILTER",
            "required": false,
            "secret": false,
            "description": "A JSON filter in Notion's own syntax, ANDed with the poll watermark."
          },
          {
            "name": "NOTION_STATUS_PROPERTY",
            "required": false,
            "secret": false,
            "description": "Name of the property carrying status. Blank uses the first status, then select, property."
          },
          {
            "name": "NOTION_LIMIT",
            "required": false,
            "secret": false
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "type": "createPage",
      "label": "Create a page",
      "description": "Add a page to the configured data source.",
      "idempotent": false,
      "inputs": [
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "key": "markdown",
          "label": "Body",
          "type": "string",
          "required": false,
          "description": "Paragraphs and # headings."
        },
        {
          "key": "properties",
          "label": "Properties",
          "type": "string",
          "required": false,
          "description": "JSON object of Notion property values, in the API’s own shape."
        }
      ],
      "outputs": [
        {
          "key": "id",
          "description": "The new page id"
        },
        {
          "key": "url",
          "description": "Where to open it"
        }
      ]
    },
    {
      "type": "updatePage",
      "label": "Update a page",
      "description": "Set properties on an existing page.",
      "idempotent": true,
      "inputs": [
        {
          "key": "pageId",
          "label": "Page",
          "type": "string",
          "required": true,
          "description": "Page URL or id."
        },
        {
          "key": "title",
          "label": "Title",
          "type": "string",
          "required": false
        },
        {
          "key": "properties",
          "label": "Properties",
          "type": "string",
          "required": false,
          "description": "JSON object of Notion property values."
        }
      ],
      "outputs": [
        {
          "key": "url",
          "description": "Where to open it"
        }
      ]
    },
    {
      "type": "findPages",
      "label": "Find pages",
      "description": "Query the configured data source and return the pages it matches.",
      "idempotent": true,
      "inputs": [
        {
          "key": "filter",
          "label": "Filter",
          "type": "string",
          "required": false,
          "description": "A JSON filter in Notion's own syntax."
        },
        {
          "key": "limit",
          "label": "Maximum results",
          "type": "number",
          "required": false
        }
      ],
      "outputs": [
        {
          "key": "count",
          "type": "number",
          "description": "How many pages came back"
        },
        {
          "key": "pages",
          "description": "id, url, title and status for each"
        },
        {
          "key": "truncated",
          "type": "boolean",
          "description": "True when Notion hit its 10,000-result ceiling"
        }
      ]
    }
  ]
}
