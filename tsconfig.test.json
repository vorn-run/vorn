{
  // The tests. Vitest strips their types through esbuild without checking
  // them, so this project is what makes a test agree with the code it tests.
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    // DOM for the fetch, WebSocket and URL globals the suite uses.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    // `completion-extract` and `lockfile-entries` import helpers from
    // `scripts/*.mjs`. Resolved, not checked -- those are outside this gate.
    "allowJs": true,
    "checkJs": false,
    // Not `vitest/globals`, despite `globals: true` in vitest.config.ts: every
    // test file imports what it uses from 'vitest' by name.
    "types": ["node"],
    "paths": {
      "@vornrun/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["tests/**/*"]
}
