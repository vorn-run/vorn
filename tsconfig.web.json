{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "outDir": "./out",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@vornrun/shared": ["./packages/shared/src/index.ts"],
      "@vornrun/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    "src/renderer/**/*.json",
    "src/shared/**/*",
    "packages/shared/src/**/*"
  ]
}
