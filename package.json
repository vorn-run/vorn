{
  "name": "vorn",
  "version": "0.7.0-beta.5",
  "packageManager": "yarn@4.13.0",
  "author": "Javier Canizalez <javier-canizalez@outlook.com>",
  "description": "AI Agent Terminal Manager - Stage Manager for coding agents",
  "main": "./out/main/index.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build:server": "cd packages/server && npx tsup src/index.ts --format cjs --target node22 --external node-pty --external libsql --clean",
    "build:web": "cd packages/web && npx vite build",
    "build": "yarn build:server && yarn build:web && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint .",
    "lint:lockfile": "node scripts/check-lockfile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && yarn typecheck:server && yarn typecheck:mcp",
    "typecheck:server": "tsc --build packages/shared && tsc --noEmit -p packages/server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen:completions": "node scripts/generate-completion-index.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "deps:install": "bash scripts/yarn-install.sh",
    "prepare": "simple-git-hooks",
    "typecheck:mcp": "tsc --build --force packages/shared packages/server && tsc --noEmit -p packages/mcp/tsconfig.json"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/sync-versions.sh && yarn lint-staged",
    "pre-push": "yarn typecheck"
  },
  "lint-staged": {
    "yarn.lock": "node scripts/check-lockfile.mjs --fix",
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tiptap/core": "^3.27.4",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-link": "^3.30.3",
    "@tiptap/extension-list": "^3.27.4",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.27.4",
    "@tiptap/extensions": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "@tiptap/suggestion": "^3.27.4",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "libsql": "^0.5.29",
    "lowlight": "^3.3.0",
    "lucide-react": "1.34.0",
    "node-cron": "^4.2.1",
    "node-pty": "1.2.0-beta.13",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.3",
    "shiki": "^4.2.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "electron": "^41.10.3",
    "electron-builder": "^26.10.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "node-gyp": "^13.0.1",
    "postcss": "^8.5.23",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.5",
    "@xmldom/xmldom": "^0.8.10",
    "hono": "^4.13.1",
    "@hono/node-server": "^2.0.11",
    "lodash": "^4.18.1",
    "flatted": "^3.4.2",
    "tar": "^7.5.21",
    "path-to-regexp": "^8.4.2",
    "picomatch": "^4.0.4",
    "fastify": "^5.11.0",
    "js-yaml": "^4.3.1",
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.5",
    "node-gyp/undici": "^8.9.0",
    "tsup/esbuild": "^0.28.1",
    "postcss": "^8.5.23"
  }
}
