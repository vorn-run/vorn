{
  "name": "vorn",
  "version": "0.8.0-beta.15",
  "packageManager": "yarn@4.13.0",
  "author": "Javier Canizalez <javier-canizalez@outlook.com>",
  "description": "AI Agent Terminal Manager - Stage Manager for coding agents",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:web": "sh packages/core/scripts/build-web.sh",
    "build:core": "yarn workspace @vornrun/core build",
    "bench:panes": "sh packages/core/scripts/many-pane-bench.sh",
    "bench:board": "sh packages/core/scripts/board-bench.sh",
    "bench:startup": "bash packages/core/scripts/startup-bench.sh",
    "lint": "eslint .",
    "lint:lockfile": "node scripts/check-lockfile.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "yarn typecheck:mcp && yarn typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deps:install": "bash scripts/yarn-install.sh",
    "prepare": "simple-git-hooks",
    "typecheck:mcp": "tsc --build --force packages/shared && tsc --noEmit -p packages/mcp/tsconfig.json"
  },
  "simple-git-hooks": {
    "pre-commit": "bash scripts/sync-versions.sh && yarn lint-staged",
    "pre-push": "yarn typecheck"
  },
  "lint-staged": {
    "yarn.lock": "node scripts/check-lockfile.mjs --fix",
    "*.ts": [
      "eslint --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,css,md,html}": "prettier --write"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "shiki": "^4.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "libsql": "^0.5.29",
    "lint-staged": "^17.6.0",
    "playwright-core": "1.64.0",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.14.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.2.2",
    "vitest": "5.0.3"
  },
  "resolutions": {
    "serialize-javascript": "^7.0.5",
    "@xmldom/xmldom": "^0.8.15",
    "hono": "^4.13.7",
    "@hono/node-server": "^2.0.11",
    "lodash": "^4.18.1",
    "flatted": "^3.4.2",
    "tar": "^7.5.21",
    "path-to-regexp": "^8.4.2",
    "node-abi": "^4.35.0",
    "qs": "^6.16.0",
    "picomatch": "^4.0.4",
    "@humanfs/node": "^0.16.8",
    "js-yaml": "^4.3.2",
    "ip-address": "^10.7.1",
    "fast-uri": "^3.1.8",
    "tsup/esbuild": "^0.28.1",
    "postcss": "^8.5.23"
  }
}
