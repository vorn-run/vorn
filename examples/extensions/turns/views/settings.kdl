// What Turns counts, and the list it keeps.
schema "vorn:view@1"

rows "prefs" {
    label string
    on bool
}

rows "plans" {
    name string
    selected bool
}

rows "account" {
    name string
    signed_in bool
}

rows "finished" {
    session string
    name string
    turn number
    at string
}

column {
    section "Counting" {
        list "prefs" {
            toggle "{row.on}" label="{row.label}" call="pref"
        }
    }
    section "Account" {
        choice "plans" label="{row.name}" selected="{row.selected}" call="plan"
        field placeholder="Paste a key" call="key" secret=#true
        list "account" {
            row {
                text "{row.name}" grow=#true
                button "Sign in" signin="{row.id}" when="!{row.signed_in}"
            }
        }
    }
    section "Finished turns" {
        row {
            text "Kept: {finished.count}, the latest first" role=secondary grow=#true
            button Clear call="ask-clear" style=danger
        }
    }
}
