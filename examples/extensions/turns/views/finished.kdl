// The latest turns that finished, newest first.
schema "vorn:view@1"

rows "finished" {
    session string
    name string
    turn number
    at string
}

column when="{finished.count}" {
    list "finished" {
        row {
            icon check tone=good
            text "{row.name}" grow=#true
            text "#{row.turn} {row.at}" role=mono
            button Show focus="{row.session}"
        }
    }
}
