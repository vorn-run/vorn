// Run it by hand: it shouts what you give it.
workflow "Try Shout" {
    id "try-shout"
    enabled #true
    trigger "manual" id="start" {
        inputs {
            - {
                key "words"
                label "Words"
                type "text"
            }
        }
    }
    step "shout" id="loud" slug="loud" {
        text "{{inputs.words}}"
        times 2
    }
}
