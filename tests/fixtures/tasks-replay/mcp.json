    {
      "name": "get_my_context",
      "description": "Get your current task and project context. Auto-detects based on your working directory. Call this at the start of a session to understand what you are working on.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "cwd": {
            "description": "Your current working directory (auto-detected if omitted). Used to match against known projects and task worktrees.",
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "task_id": {
            "description": "Specific task ID to get context for (overrides auto-detection)",
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "execution": {
        "taskSupport": "forbidden"
      }
    }
